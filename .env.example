# No secrets and no paid services (D-01). These are public build-time values.
# Copy to .env.local for local overrides. The host sets the same names in its dashboard.

# Canonical site URL, used for metadata and share cards. Changes when the name lands (O-01).
NEXT_PUBLIC_SITE_URL=https://probuilds.club

# Public repo, used by Submit to build the prefilled GitHub issue URL (A-04)
NEXT_PUBLIC_REPO_URL=https://github.com/ChimeXXD/probuilds

# Takedown contact shown on /takedown (D-10, D-53).
NEXT_PUBLIC_TAKEDOWN_EMAIL=takedown@probuilds.club
