NEXT_PUBLIC_REPO_URL=https://github.com/ChimeXXD/pro-clubs-hub

# Takedown contact shown on /takedown (D-10). TODO: Chime to confirm the address (O-13).
NEXT_PUBLIC_TAKEDOWN_EMAIL=TODO
